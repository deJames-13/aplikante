# ==============================================================================
# Aplikante Monorepo Root .gitignore
# Covering both web/ (TanStack Start / React / Vite) & server/ (Django / Python)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*~
*.swp
*.swo
*.bak

# ------------------------------------------------------------------------------
# IDEs & Developer Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.local
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# Frontend / Web (Node.js, Vite, TanStack Start, Nitro)
# ------------------------------------------------------------------------------
web/node_modules/
node_modules/
dist/
dist-ssr/
web/dist/
web/dist-ssr/
.output/
web/.output/
.nitro/
web/.nitro/
.tanstack/
web/.tanstack/
.vite/
web/.vite/
.wrangler/
web/.wrangler/
.vinxi/
web/.vinxi/
__unconfig*
todos.json

# Test Coverage & Framework Caches
coverage/
web/coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Backend / Server (Python, Django, Virtual Environments)
# ------------------------------------------------------------------------------
server/.venv/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
server/**/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
downloads/
eggs/
.eggs/
server/lib/
server/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Never ignore web source code
!web/src/**

# Django Database & Static Asset Outputs
server/db.sqlite3
server/db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
server/staticfiles/
server/media/
staticfiles/
media/

# Python Testing & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# Local Scratch & Project References
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
